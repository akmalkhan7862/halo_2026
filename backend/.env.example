# Server Configuration
PROJECT_NAME="Resume Intelligence & Mock Interview Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
# Uses SQLite locally by default if PostgreSQL is not running.
# In production, set DATABASE_URL to PostgreSQL:
# postgresql://postgres:postgres@localhost:5432/resume_platform
DATABASE_URL="sqlite:///./resume_platform.db"

# Security & Authentication
SECRET_KEY="supersecretchangeinproductionwithopensslrandhex32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# LLM Configuration (OpenAI or compatible providers like Groq, Ollama, vLLM)
LLM_PROVIDER="openai"
LLM_API_KEY="your-llm-api-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Scoring Engine Weights (Must sum to 1.0)
WEIGHT_SKILL_MATCH=0.35
WEIGHT_EXPERIENCE=0.20
WEIGHT_PROJECT=0.20
WEIGHT_KEYWORD=0.15
WEIGHT_SENIORITY=0.10

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf","docx"]

# Taxonomy Configuration
DEFAULT_TAXONOMY_SOURCES=["esco","onet","custom"]
FUZZY_MATCH_THRESHOLD=0.82
